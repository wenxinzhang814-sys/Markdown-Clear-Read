<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta http-equiv="x-ua-compatible" content="IE=edge" />
<meta charset="utf-8" />
<title>清阅 Markdown</title>
<HTA:APPLICATION ID="QingYueMarkdown" APPLICATIONNAME="清阅 Markdown" BORDER="thin" BORDERSTYLE="normal" CAPTION="yes" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes" SYSMENU="yes" WINDOWSTATE="normal" />
<style>
:root{--bg:#f3f5f7;--surface:#fff;--ink:#20262e;--muted:#7c8794;--line:#e5e9ee;--accent:#3478f6;--quote:#eaf2ff;--code:#f4f6f8;--shadow:0 16px 40px rgba(29,43,64,.08)}
*{box-sizing:border-box}html,body{height:100%;margin:0}body{font-family:"Segoe UI","Microsoft YaHei",sans-serif;color:var(--ink);background:var(--bg);overflow:hidden}
.app{height:100vh;display:flex;flex-direction:column}.topbar{height:56px;display:flex;align-items:center;gap:12px;padding:0 18px;background:rgba(255,255,255,.92);border-bottom:1px solid var(--line);flex:none}
.brand{display:flex;align-items:center;gap:10px;font-weight:650;letter-spacing:.2px;min-width:190px}.brandmark{width:28px;height:28px;border-radius:8px;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:15px;box-shadow:0 4px 10px rgba(52,120,246,.25)}
.filename{color:var(--muted);font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}.actions{display:flex;gap:6px}.iconbtn{width:34px;height:34px;border:1px solid transparent;border-radius:8px;background:transparent;color:#667281;font-size:16px;cursor:pointer}.iconbtn:hover{background:#eef3fa;color:var(--accent)}
.main{min-height:0;display:flex;flex:1}.sidebar{width:250px;flex:none;border-right:1px solid var(--line);background:#f8fafc;padding:20px 14px;overflow:auto}.side-label{font-size:11px;color:#a1abb7;letter-spacing:1px;text-transform:uppercase;padding:0 10px 10px}.toc a{display:block;color:#667281;text-decoration:none;font-size:13px;padding:7px 10px;border-radius:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.toc a:hover{background:#edf3fb;color:var(--accent)}.toc a.h2{padding-left:22px}.toc a.h3{padding-left:34px;font-size:12px}
.reading{flex:1;min-width:0;overflow:auto;padding:38px 42px 80px}.paper{max-width:900px;margin:0 auto;background:var(--surface);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);padding:54px 72px 68px}.empty{text-align:center;padding:100px 20px;color:var(--muted)}
article{font-family:Georgia,"Times New Roman","Microsoft YaHei",serif;font-size:16px;line-height:1.85}article h1,article h2,article h3,article h4{font-family:"Segoe UI","Microsoft YaHei",sans-serif;line-height:1.35;color:var(--ink);margin:1.5em 0 .55em}article h1{font-size:32px;margin-top:0;letter-spacing:-.4px}article h2{font-size:24px;border-bottom:1px solid var(--line);padding-bottom:8px}article h3{font-size:19px}article p{margin:0 0 1em}article a{color:var(--accent);text-decoration:none}article a:hover{text-decoration:underline}article blockquote{margin:1.2em 0;padding:10px 18px;border-left:4px solid #8cb3f8;background:var(--quote);color:#526172}article ul,article ol{padding-left:1.5em}article li{margin:.25em 0}article hr{border:0;border-top:1px solid var(--line);margin:2em 0}article img{max-width:100%;border-radius:8px;display:block;margin:1em auto}article code{font-family:Consolas,"Courier New",monospace;font-size:.88em;background:var(--code);border-radius:4px;padding:2px 5px;color:#b34a67}article pre{background:#202733;color:#e5edf7;border-radius:8px;padding:16px 18px;overflow:auto;line-height:1.55}article pre code{background:none;color:inherit;padding:0}article table{border-collapse:collapse;width:100%;margin:1em 0;font-family:"Segoe UI","Microsoft YaHei",sans-serif;font-size:14px}article th,article td{border:1px solid var(--line);padding:8px 10px;text-align:left}article th{background:#f5f7f9;font-weight:600}article input{accent-color:var(--accent);margin-right:7px}
.status{position:fixed;bottom:14px;right:20px;color:#a0a9b3;font-size:11px}.dark{--bg:#171b21;--surface:#20262f;--ink:#e7ecf2;--muted:#a2adba;--line:#343d48;--quote:#26364d;--code:#2a313b;--shadow:0 16px 40px rgba(0,0,0,.2)}.dark .topbar,.dark .sidebar{background:#1c222a}.dark article th{background:#2a313b}
@media(max-width:780px){.sidebar{width:190px}.reading{padding:18px}.paper{padding:34px 28px}.brand{min-width:auto}.brand span{display:none}}
</style>
</head>
<body>
<div class="app"><header class="topbar"><div class="brand"><div class="brandmark">M</div><span>清阅</span></div><div id="filename" class="filename">未打开文档</div><div class="actions"><button class="iconbtn" id="searchBtn" title="搜索（Ctrl+F）">⌕</button><button class="iconbtn" id="themeBtn" title="切换主题">◐</button><button class="iconbtn" id="openBtn" title="打开文件">＋</button></div></header><main class="main"><aside class="sidebar"><div class="side-label">目录</div><nav id="toc" class="toc"></nav></aside><section class="reading"><div id="paper" class="paper"><div class="empty">双击 Markdown 文件即可开始阅读</div></div></section></main><div id="status" class="status"></div></div>
<script>
(function(){
 var filePath=getQueryFile(), fileName=filePath?filePath.split(/\\|\//).pop():'';
 var paper=document.getElementById('paper'), toc=document.getElementById('toc'), filename=document.getElementById('filename'), status=document.getElementById('status');
 document.getElementById('themeBtn').onclick=function(){document.body.classList.toggle('dark');try{localStorage.qyDark=document.body.classList.contains('dark')?'1':'0'}catch(e){}};
 try{if(localStorage.qyDark==='1')document.body.classList.add('dark')}catch(e){}
 document.getElementById('searchBtn').onclick=search;document.onkeydown=function(e){if((e.ctrlKey||e.metaKey)&&e.keyCode===70){e.preventDefault();search()}};
 document.getElementById('openBtn').onclick=function(){try{new ActiveXObject('Shell.Application').BrowseForFolder(0,'选择 Markdown 文件所在文件夹',0)}catch(e){alert('请直接双击 .md 文件打开。')}};
 if(filePath)load(filePath);
 function getQueryFile(){var q=location.search.replace(/^\?/,'');if(!q)return '';try{return decodeURIComponent(q)}catch(e){return q}}
 function load(path){filename.textContent=fileName||path;try{var text=readText(path);render(text,path);status.textContent=text.length.toLocaleString()+' 字符'}catch(e){paper.innerHTML='<div class="empty">无法读取此文件<br><small>'+escapeHtml(path)+'</small></div>'}}
 function readText(path){var bin=new ActiveXObject('ADODB.Stream');bin.Type=1;bin.Open();bin.LoadFromFile(path);var bytes=bin.Read();bin.Close();var a=new VBArray(bytes).toArray(),b0=a.length>0?a[0]:0,b1=a.length>1?a[1]:0,b2=a.length>2?a[2]:0;if(b0===255&&b1===254)return decodeBytes(path,'unicode');if(b0===254&&b1===255)return decodeBytes(path,'unicodeFFFE');if(b0===239&&b1===187&&b2===191)return decodeBytes(path,'utf-8');var utf=decodeBytes(path,'utf-8');if(utf.indexOf('\ufffd')>=0)return decodeBytes(path,'gb18030');return utf}
 function decodeBytes(path,charset){var s=new ActiveXObject('ADODB.Stream');s.Type=1;s.Open();s.LoadFromFile(path);s.Position=0;s.Type=2;s.Charset=charset;var text=s.ReadText();s.Close();return text.replace(/^\ufeff/,'')}
 function render(md,path){var html=markdown(md,path);paper.innerHTML='<article>'+html+'</article>';buildToc()}
 function buildToc(){toc.innerHTML='';var hs=paper.querySelectorAll('h1,h2,h3');for(var i=0;i<hs.length;i++){var h=hs[i],id='heading-'+i;h.id=id;var a=document.createElement('a');a.href='#'+id;a.className=h.tagName.toLowerCase();a.textContent=h.textContent;a.onclick=function(){return true};toc.appendChild(a)}}
 function markdown(s,path){s=s.replace(/\r\n?/g,'\n');var lines=s.split('\n'),out=[],i=0,inCode=false,code=[],lang='';while(i<lines.length){var l=lines[i];if(/^\s*```/.test(l)){if(!inCode){inCode=true;lang=l.replace(/^\s*```/,'').trim()}else{out.push('<pre><code class="lang-'+escapeAttr(lang)+'">'+escapeHtml(code.join('\n'))+'</code></pre>');code=[];inCode=false;lang=''}i++;continue}if(inCode){code.push(l);i++;continue}if(!l.trim()){i++;continue}var h=l.match(/^(#{1,4})\s+(.+)$/);if(h){out.push('<h'+h[1].length+'>'+inline(h[2],path)+'</h'+h[1].length+'>');i++;continue}if(/^---+$/.test(l.trim())){out.push('<hr>');i++;continue}if(/^>\s?/.test(l)){var q=[];while(i<lines.length&&/^>\s?/.test(lines[i])){q.push(lines[i].replace(/^>\s?/,'').trim());i++}out.push('<blockquote>'+inline(q.join(' '),path)+'</blockquote>');continue}if(/^\s*[-*+]\s+/.test(l)||/^\s*\d+\.\s+/.test(l)){var ordered=/^\s*\d+\.\s+/.test(l),items=[];while(i<lines.length&&(/^(\s*[-*+]\s+)|(\s*\d+\.\s+)/.test(lines[i]))){var item=lines[i].replace(/^\s*(?:[-*+]\s+|\d+\.\s+)/,'');var task=item.match(/^\[([ xX])\]\s+(.*)$/);items.push('<li>'+(task?'<input type="checkbox" disabled '+(task[1].toLowerCase()==='x'?'checked':'')+'>'+inline(task[2],path):inline(item,path))+'</li>');i++}out.push('<'+(ordered?'ol':'ul')+'>'+items.join('')+'</'+(ordered?'ol':'ul')+'>');continue}if(/^\|/.test(l)&&i+1<lines.length&&/^\|?\s*:?-+:?\s*(\||$)/.test(lines[i+1])){var heads=l.split('|').slice(1,-1).map(function(x){return '<th>'+inline(x.trim(),path)+'</th>'}).join('');i+=2;var rows=[];while(i<lines.length&&/^\|/.test(lines[i])){rows.push('<tr>'+lines[i].split('|').slice(1,-1).map(function(x){return '<td>'+inline(x.trim(),path)+'</td>'}).join('')+'</tr>');i++}out.push('<table><thead><tr>'+heads+'</tr></thead><tbody>'+rows.join('')+'</tbody></table>');continue}var para=[l];i++;while(i<lines.length&&lines[i].trim()&&!/^(#{1,4})\s+|^\s*```|^\s*[-*+]\s+|^\s*\d+\.\s+|^>|^\|/.test(lines[i]))para.push(lines[i++]);out.push('<p>'+inline(para.join('\n'),path)+'</p>')}return out.join('')}
 function inline(s,path){s=escapeHtml(s);s=s.replace(/!\[([^\]]*)\]\(([^)]+)\)/g,function(_,a,u){return '<img alt="'+escapeAttr(a)+'" src="'+escapeAttr(resolve(u,path))+'">'});s=s.replace(/\[([^\]]+)\]\(([^)]+)\)/g,'<a href="$2">$1</a>');s=s.replace(/`([^`]+)`/g,'<code>$1</code>').replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>').replace(/__([^_]+)__/g,'<strong>$1</strong>').replace(/\*([^*]+)\*/g,'<em>$1</em>').replace(/_([^_]+)_/g,'<em>$1</em>').replace(/\n/g,'<br>');return s}
 function resolve(u,path){if(/^(https?:|data:|file:)/i.test(u))return u;var base=path.replace(/[^\\\/]+$/,'');return 'file:///'+(base+u).replace(/\\/g,'/').replace(/ /g,'%20')}
 function escapeHtml(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')};function escapeAttr(s){return escapeHtml(s)}
 function search(){var q=prompt('搜索文档内容');if(!q)return;var text=paper.innerText.toLowerCase(),n=text.indexOf(q.toLowerCase());if(n<0){alert('未找到：'+q);return}status.textContent='已找到：'+q;var range=document.createRange(),node=paper.querySelector('article').firstChild;if(node){range.selectNodeContents(paper.querySelector('article'));window.getSelection().removeAllRanges();window.getSelection().addRange(range)}}
})();
</script>
</body>
</html>
